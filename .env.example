# mcp-wordpress-oauth configuration. Reasons for every default: docs/decisions.md.

# ── This server ───────────────────────────────────────────────────────────────
# Public URL of this server, without a trailing slash; include a reverse-proxy
# sub-directory if there is one (e.g. https://ai.example.com/mcp/wordpress).
BASE_URL=https://mcp-wp.example.com
# How MCP clients authenticate TO THIS SERVER (D4):
# resource  (default) accept Keycloak access tokens forwarded by the client
#           (Open WebUI "OAuth"); WordPress accepts the same token through
#           the MCP Bearer Auth plugin (wordpress-plugin/). Stateless.
# proxy     additionally run the MCP OAuth flow against Keycloak, for clients
#           that insist on Dynamic Client Registration.
# wordpress this server is its own OAuth 2.1 server (claude.ai, ChatGPT);
#           users sign in to WordPress and approve an Application Password.
AUTH_MODE=resource
#HOST=0.0.0.0
#PORT=8000
#LOG_LEVEL=INFO

# ── WordPress ─────────────────────────────────────────────────────────────────
# The site, as users know it. In AUTH_MODE=wordpress browsers are sent to
# $WORDPRESS_URL/wp-admin/authorize-application.php, so it must be the public URL.
WORDPRESS_URL=https://wp.example.com
# Plain http only with this switch (local test setups); credentials travel over it.
#WORDPRESS_ALLOW_HTTP=off
# Same for BASE_URL (local tests only: OAuth cookies and redirects need HTTPS).
# AUTH_MODE=resource only; proxy and wordpress allow plain http just on localhost.
#BASE_URL_ALLOW_HTTP=off
# REST API prefix. Empty for sites without pretty permalinks (?rest_route=).
#WP_REST_PREFIX=/wp-json
# PEM bundle replacing the system trust store (private CA).
#WORDPRESS_CA_FILE=/certs/ca.pem
#WORDPRESS_TIMEOUT=30

# ── Which abilities become tools (D1, D2) ─────────────────────────────────────
# Comma-separated globs on ability names; deny wins.
#ABILITY_ALLOW=*
#ABILITY_DENY=
# Only abilities with meta.mcp.public = true, like WordPress' own MCP Adapter.
#ABILITY_MCP_PUBLIC_ONLY=on
# Seconds a user's ability list is cached; 0 = ask WordPress every time.
#ABILITY_CACHE_TTL=300
#ABILITY_MAX=1000

# ── AUTH_MODE=resource / proxy: Keycloak ──────────────────────────────────────
# `iss` of the tokens, exactly (Keycloak: <public frontend URL>/realms/<realm>).
OIDC_ISSUER=https://sso.example.com/realms/main
# Only if this container reaches Keycloak under another hostname than the
# public issuer. Unset = from the issuer's discovery document.
#OIDC_JWKS_URI=http://keycloak:8080/realms/main/protocol/openid-connect/certs
# Tokens must carry this in `aud`; the same value goes into MCP_BEARER_AUDIENCE
# in WordPress' wp-config.php (MCP Bearer Auth).
#MCP_AUDIENCE=mcp-wordpress
# proxy only: this server's Keycloak client (redirect URI $BASE_URL/auth/callback).
#OIDC_CLIENT_ID=mcp-wordpress
#OIDC_CLIENT_SECRET=
# proxy only, recommended: signs this server's session tokens. Unset = derived
# from OIDC_CLIENT_SECRET, so rotating that would end every session.
#JWT_SIGNING_KEY=

# ── AUTH_MODE=wordpress: this server as OAuth authorization server ───────────
# Signs the tokens this server issues. openssl rand -base64 48
#OAUTH_JWT_SIGNING_KEY=
# Encrypts stored Application Passwords, clients and sessions (D8).
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
#OAUTH_STORAGE_KEY=
#OAUTH_STATE_DIR=/data/oauth
# Dynamic Client Registration (/register), needed by ChatGPT; claude.ai
# identifies itself with a metadata URL instead (D9).
#OAUTH_DCR_ENABLED=off
# Where clients may send users back to. Wildcards only in the path; http only
# for loopback, any port. Unset = ChatGPT's and Claude's callbacks + loopback.
#OAUTH_REDIRECT_ALLOWLIST=https://chatgpt.com/connector/oauth/*,https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/backend-api/aip/connectors/links/oauth/callback,https://chat.openai.com/connector_platform_oauth_redirect,https://chat.openai.com/aip/*/oauth/callback,https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost,http://127.0.0.1,http://[::1]
# Client metadata documents (CIMD) accepted as client ids. Empty = CIMD off.
#OAUTH_CIMD_ALLOWLIST=https://claude.ai/oauth/mcp-oauth-client-metadata,https://claude.ai/oauth/claude-code-client-metadata
# Name of the Application Password in the user's WordPress profile.
#OAUTH_APP_NAME=MCP (mcp-wp.example.com)
#OAUTH_ACCESS_TOKEN_TTL=3600
#OAUTH_REFRESH_TOKEN_TTL=2592000
# Seconds between checks that a user's Application Password still works
# (revoking it in WordPress ends the session within this time).
#WP_CREDENTIAL_RECHECK=60
# Only these WordPress roles may connect (comma-separated). Empty = any user.
#WP_ALLOWED_ROLES=
