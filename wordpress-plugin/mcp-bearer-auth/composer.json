{
    "name": "linuxrrze/mcp-bearer-auth",
    "description": "Accept an OIDC provider's access tokens (Authorization: Bearer) on the WordPress Abilities and MCP REST routes, as the matching WordPress user.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": { "MCPBearerAuth\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MCPBearerAuth\\Tests\\": "tests/" }
    },
    "config": {
        "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
        "platform": { "php": "8.1.31" }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs"
    }
}
